              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/notebooks/{name}": {
      "delete": {
        "tags": [
          "notebooks"
        ],
        "operationId": "delete_notebook",
        "parameters": [
          {
