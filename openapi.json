                    "$ref": "#/components/schemas/NoteMeta"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}/move": {
      "post": {
        "tags": [
          "notes"
        ],
        "operationId": "move_note",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/duplicates/dismiss": {
      "post": {
        "tags": [
          "system"
        ],
        "operationId": "dismiss_duplicates",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/system/rescan": {
      "post": {
        "tags": [
          "system"
        ],
        "operationId": "rescan",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": [
          "tags"
        ],
        "summary": "Counts double as the preview of how many notes a rename or merge touches.",
        "operationId": "list_tags",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tag"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tags/rename": {
      "post": {
        "tags": [
          "tags"
        ],
        "summary": "Rewrites every affected note. Merges when the target tag already exists.",
        "operationId": "rename_tag",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameTag"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenameTagResult"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/trash": {
      "get": {
        "tags": [
          "trash"
        ],
        "operationId": "list_trash",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrashItem"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "trash"
        ],
        "operationId": "empty_trash",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/trash/{key}": {
      "delete": {
        "tags": [
          "trash"
        ],
        "operationId": "purge_item",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/trash/{key}/restore": {
      "post": {
        "tags": [
          "trash"
        ],
        "operationId": "restore_item",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetUploaded": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Relative path to use inside a note."
          }
        }
      },
      "CreateNote": {
        "type": "object",
        "required": [
          "notebook",
          "body"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "notebook": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Duplicate": {
        "type": "object",
        "required": [
          "path",
          "new_id"
        ],
        "properties": {
          "new_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LoadError": {
        "type": "object",
        "required": [
          "path",
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "MoveNote": {
        "type": "object",
        "required": [
          "notebook"
        ],
        "properties": {
          "notebook": {
            "type": "string"
          }
        }
      },
      "Note": {
        "type": "object",
        "required": [
          "meta",
          "body",
          "version"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/NoteMeta"
          },
          "version": {
            "type": "string",
            "description": "Pass back as `base_version` when saving."
          }
        }
      },
      "NoteMeta": {
        "type": "object",
        "required": [
          "id",
          "path",
          "notebook",
          "summary",
          "tags"
        ],
        "properties": {
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "notebook": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "snippet": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Snippet"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Notebook": {
        "type": "object",
        "required": [
          "name",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "NotebookName": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "RenameTag": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      },
      "RenameTagResult": {
        "type": "object",
        "required": [
          "affected"
        ],
        "properties": {
          "affected": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SaveNote": {
        "type": "object",
        "required": [
          "body",
          "base_version"
        ],
        "properties": {
          "base_version": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "force": {
            "type": "boolean",
            "description": "Overwrite even if the note changed since `base_version`."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Snippet": {
        "type": "object",
        "required": [
          "text",
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "description": "Character offsets of the match within `text`.",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "errors",
          "duplicates"
        ],
        "properties": {
          "duplicates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Duplicate"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoadError"
            }
          }
        }
      },
      "Tag": {
        "type": "object",
        "required": [
          "tag",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int64"
          },
          "tag": {
            "type": "string"
          }
        }
      },
      "TrashItem": {
        "type": "object",
        "required": [
          "key",
          "notebook",
          "trashed_at_millis"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": "string"
          },
          "notebook": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "trashed_at_millis": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
